digraph "uart_top" {
label="uart_top";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="baud_tick", color="black", fontcolor="black"];
n2 [ shape=octagon, label="tx_done", color="black", fontcolor="black"];
n3 [ shape=octagon, label="tx_busy", color="black", fontcolor="black"];
n4 [ shape=octagon, label="tx", color="black", fontcolor="black"];
n5 [ shape=octagon, label="tx_data", color="black", fontcolor="black"];
n6 [ shape=octagon, label="tx_start", color="black", fontcolor="black"];
n7 [ shape=octagon, label="reset", color="black", fontcolor="black"];
n8 [ shape=octagon, label="clk", color="black", fontcolor="black"];
v0 [ label="" ];
c10 [ shape=record, label="{{<p1> baud_tick|<p8> clk|<p7> reset|<p5> tx_data|<p6> tx_start}|transmitter\nuart_tx|{<p9> state|<p4> tx|<p3> tx_busy|<p2> tx_done}}",  ];
c11 [ shape=record, label="{{<p8> clk|<p7> reset}|baud_gen\n$paramod$d40569e2e5029e2dde4c9be19ab6c750b8104d07&#9586;baud_generator|{<p1> baud_tick}}",  ];
c11:p1:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c10:p1:w [color="black", fontcolor="black", label=""];
c10:p2:e -> n2:w [color="black", fontcolor="black", label=""];
